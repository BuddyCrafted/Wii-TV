<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Forecast Channel (Open-Meteo) and the over-the-air updater (GitHub releases). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The updater installs new builds of itself; build-and-install.sh allows it over ADB. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed since Android 10 to read the Wi-Fi network name for the network pill. Never requested at
         runtime: build-and-install grants it with pm grant, so lint's Android 12 "ask for COARSE with
         FINE" rule does not apply here. -->
    <!-- Settings > Screensaver & sleep sets the TV's own timers. Both are granted only over ADB, by
         build-and-install.sh (appops for WRITE_SETTINGS, pm grant for WRITE_SECURE_SETTINGS); without them the
         launcher opens the system page instead. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />

    <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
         apps that declare a module card (docs/specs/card.md). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
        </intent>
        <!-- The Shop Channel opens apps' store pages. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amzn" />
        </intent>
        <!-- China-market MIUI TV firmware: the Settings and Wi-Fi pills fall back to Xiaomi's settings app. -->
        <package android:name="com.xiaomi.mitv.settings" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <!-- The home screen, in the style of the old console channel menu. -->
        <activity
            android:name=".WiiMenuActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity (the older glass grid titled lainOS) and its LauncherSettingsActivity are not declared:
             WiiOS is the only home screen. Quick Settings' launcher row opens WiiOS Settings instead. -->
        <!-- Remote Settings button panel (settings_key_panel); own task so the app behind stays put. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <activity
            android:name=".ForecastActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity
            android:name=".ShopActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- Web games from the Games channel, full screen. -->
        <activity
            android:name=".WebPlayActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- Updater: the package installer's status, and switching the Fire TV Home redirect back on after an update. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Now Playing screensaver: the clock, and the artwork and title of what is playing. -->
        <service
            android:name=".NowPlayingDream"
            android:label="@string/np_dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <activity
            android:name=".NowPlayingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- Lets the Now Playing screensaver read media sessions; ignores notifications. Enabled over ADB. -->
        <service
            android:name=".MediaListener"
            android:label="@string/np_listener_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fire TV: Fire OS will not hand Home to another app, so this service takes the Home button and
             covers the Amazon launcher whenever it shows. build-and-install.sh enables it on Fire TV. -->
        <service
            android:name=".FireTvHomeService"
            android:label="@string/fire_home_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fire_tv_home_service" />
        </service>

        <!-- System Update, full screen while it downloads and installs. -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Phone remote: the QR code to scan. -->
        <activity
            android:name=".PhoneRemoteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Who's watching? and the profile look editor. -->
        <activity
            android:name=".ProfilesActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The Wii and Aquarium screensavers (SaverDream), and their preview. -->
        <service
            android:name=".SaverDream$Wii"
            android:label="@string/dream_wii"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <service
            android:name=".SaverDream$Aquarium"
            android:label="@string/dream_aquarium"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <activity
            android:name=".SaverActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- tools/theme.sh writes the theme through this where the shell can't reach Android/data;
             see ThemeProvider. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't. -->
        <provider
            android:name=".ThemeProvider"
            android:authorities="${applicationId}.theme"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- The remote's Input button (KEYCODE_TV or KEYCODE_TV_INPUT) opens the input switcher, and input_key_keycodes and
         app_keys (config.xml or a theme) bring back other remote buttons; see InputKeyService. -->
        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>
    </application>
</manifest>

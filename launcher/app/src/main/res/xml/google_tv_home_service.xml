<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes from the stock launchers only (GoogleTvHomeService): nothing else is heard. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/gtv_home_description"
    android:notificationTimeout="0"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher" />

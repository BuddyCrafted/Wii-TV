# Python tools
tools/venv/
__pycache__/
# The Mii pack's downloads and build: Nintendo's files stay on your computer.
tools/miipack/build/
# The ADB key: whoever has it gets a shell on every TV that accepted it.
tools/adbkey/
# Your TV's backups and dumps (serial number, android_id, network names) stay on your computer.
backups/
backup/

# Android build output
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
launcher/hs_err_pid*.log
launcher/replay_pid*.log
*.apk
*.aab

.DS_Store

# Desktop build output (desktop/web/gen is copied from the Android sources by scripts/prepare.mjs)
desktop/node_modules/
desktop/web/gen/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Your own music and sounds (a WiiOS folder for the flash drive) never go in the repository.
/WiiOS/

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiiOS",
  "version": "1.0.0",
  "identifier": "com.gathin.wiios",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "beforeDevCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WiiOS",
        "width": 1280,
        "height": 720,
        "fullscreen": true,
        "decorations": false,
        "center": true,
        "backgroundColor": "#e6e6e6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "Game",
    "shortDescription": "The channel menu for your computer",
    "copyright": "MIT"
  }
}
